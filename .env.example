# Скопируйте этот файл в .env и задайте свой пароль.
# Файл .env в git не попадает (см. .gitignore).

# Код USD/RUB в справочнике Банка России
CBR_USD_ID=R01235

# Параметры базы данных PostgreSQL
POSTGRES_DB=pas
POSTGRES_USER=pas_user
POSTGRES_PASSWORD=укажите_свой_пароль
POSTGRES_PORT=5432

# Строка подключения для запуска с хоста (не из контейнера).
# Пароль должен совпадать с POSTGRES_PASSWORD выше.
DATABASE_URL=postgresql+psycopg://pas_user:укажите_свой_пароль@localhost:5432/pas

LOG_LEVEL=INFO
